{
  "name": "tree-sitter-nlpplus",
  "version": "0.1.1",
  "description": "NLP++ grammars for tree-sitter: pass files, dictionaries, knowledge bases, analyzer sequences and parse trees",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VisualText/tree-sitter-nlpplus.git"
  },
  "license": "MIT",
  "author": {
    "name": "David de Hilster",
    "email": "dehilster@gmail.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "nlpplus",
    "nlp++",
    "nlp-plus-plus",
    "visualtext"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm",
    "dict/grammar.js",
    "dict/queries/*",
    "dict/src/**",
    "kbb/grammar.js",
    "kbb/queries/*",
    "kbb/src/**",
    "seq/grammar.js",
    "seq/queries/*",
    "seq/src/**",
    "tree/grammar.js",
    "tree/queries/*",
    "tree/src/**"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.27.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  },
  "homepage": "https://visualtext.org"
}
