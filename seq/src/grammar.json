{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "nlpplus_seq",
  "word": "name",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "pass"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_newline"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "pass"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "pass": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "inactive",
              "content": {
                "type": "SYMBOL",
                "name": "inactive"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "number",
              "content": {
                "type": "SYMBOL",
                "name": "number"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "type",
          "content": {
            "type": "SYMBOL",
            "name": "pass_type"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "FIELD",
                  "name": "file",
                  "content": {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "nil"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "name"
                      }
                    ]
                  }
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SYMBOL",
                    "name": "name"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "inactive": {
      "type": "STRING",
      "value": "/"
    },
    "pass_type": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[cC][hH][aA][rR][tT][oO][kK]|[cC][mM][lL][tT][oO][kK]|[cC][mM][lL][tT][oO][kK][eE][nN][iI][zZ][eE]|[dD][iI][cC][tT][tT][oO][kK]|[dD][iI][cC][tT][tT][oO][kK][zZ]|[eE][nN][dD]|[fF][oO][lL][dD][eE][rR]|[gG][eE][nN]|[gG][eE][nN][hH][aA][sS][hH]|[hH][aA][sS][hH]|[iI][nN][tT][eE][rR][nN]|[lL][iI][nN][eE]|[lL][iI][nN][eE][sS]|[nN][iI][nN][tT][eE][rR][nN]|[nN][lL][pP]|[pP][aA][tT]|[pP][yY][tT][hH][oO][nN]|[rR][eE][cC]|[sS][tT][uU][bB]|[tT][oO][kK]|[tT][oO][kK][eE][nN]|[tT][oO][kK][eE][nN][iI][zZ][eE]"
        }
      }
    },
    "nil": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[nN][iI][lL]"
        }
      }
    },
    "name": {
      "type": "PATTERN",
      "value": "[^\\s#\\/]+"
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "\\d+"
        }
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "#"
              },
              {
                "type": "PATTERN",
                "value": "[^\\r\\n]*"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "//"
              },
              {
                "type": "PATTERN",
                "value": "[^\\r\\n]*"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "/*"
              },
              {
                "type": "PATTERN",
                "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
              },
              {
                "type": "STRING",
                "value": "/"
              }
            ]
          }
        ]
      }
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}