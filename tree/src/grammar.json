{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "nlpplus_tree",
  "word": "word",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_line"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_newline"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_line"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "separator"
        },
        {
          "type": "SYMBOL",
          "name": "pass_header"
        },
        {
          "type": "SYMBOL",
          "name": "tree_header"
        },
        {
          "type": "SYMBOL",
          "name": "node"
        }
      ]
    },
    "separator": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "\\*\\*+"
        }
      }
    },
    "pass_header": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "PASS[ \\t]+\\d+[ \\t]+\\([^)\\r\\n]*\\)"
        }
      }
    },
    "tree_header": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[A-Z][A-Z ]* TREE:"
        }
      }
    },
    "node": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "name",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "name"
                  },
                  {
                    "type": "ALIAS",
                    "content": {
                      "type": "STRING",
                      "value": "["
                    },
                    "named": true,
                    "value": "name"
                  }
                ]
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "record",
          "content": {
            "type": "SYMBOL",
            "name": "record"
          }
        }
      ]
    },
    "name": {
      "type": "PATTERN",
      "value": "[^\\s\\[]\\S*"
    },
    "record": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "number"
              },
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "type"
              },
              {
                "type": "SYMBOL",
                "name": "flag"
              },
              {
                "type": "SYMBOL",
                "name": "variable"
              },
              {
                "type": "SYMBOL",
                "name": "word"
              },
              {
                "type": "SYMBOL",
                "name": "string"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "type": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "null"
        },
        {
          "type": "STRING",
          "value": "node"
        },
        {
          "type": "STRING",
          "value": "alpha"
        },
        {
          "type": "STRING",
          "value": "num"
        },
        {
          "type": "STRING",
          "value": "punct"
        },
        {
          "type": "STRING",
          "value": "white"
        },
        {
          "type": "STRING",
          "value": "ctrl"
        },
        {
          "type": "STRING",
          "value": "emoji"
        }
      ]
    },
    "flag": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "b"
        },
        {
          "type": "STRING",
          "value": "un"
        },
        {
          "type": "STRING",
          "value": "sem"
        },
        {
          "type": "STRING",
          "value": "fired"
        },
        {
          "type": "STRING",
          "value": "blt"
        }
      ]
    },
    "variable": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "string"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "FIELD",
            "name": "value",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "string"
                },
                {
                  "type": "SYMBOL",
                  "name": "number"
                },
                {
                  "type": "SYMBOL",
                  "name": "word"
                }
              ]
            }
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "word": {
      "type": "PATTERN",
      "value": "[^\\s\\[\\](),\"]+"
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "-?\\d+(\\.\\d+)?"
        }
      }
    },
    "string": {
      "type": "PATTERN",
      "value": "\"([^\"\\\\\\r\\n]|\\\\.)*\""
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}